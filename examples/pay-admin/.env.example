# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# 默认用户ID（开发/测试环境）
VITE_DEFAULT_USER_ID=1

# 默认API密钥（开发/测试环境）
VITE_DEFAULT_API_KEY=test_key_123456

# API基础URL（可选，默认为 /api 使用 Vite 代理转发到示例宿主 5566 端口）
# 后端接口前缀由 pay-server 中 PayPlugin 的 base_path 配置决定（默认 /api/pay，
# 与本前端一致）；宿主若修改 base_path，需同步调整前端 API 前缀。
# VITE_API_BASE_URL=http://localhost:5566
